# KiCad config + library tables seeded by scripts/kienv.sh.
# Machine-local and regenerated on demand; not part of the design.
.kicad-config/

# KiCad per-user project state (window layout, last-used settings).
*.kicad_prl
fp-info-cache

# KiCad autosave and backups.
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak
_autosave-*

# review/ is the single home for reviewable renders and is tracked in full.
# Intermediate SVG/PDF plots are written to a temp dir by make_review.sh.
